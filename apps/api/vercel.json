{
  "installCommand": "cd ../.. && NODE_ENV=development pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @tuyendung/database db:generate && pnpm --filter @tuyendung/api build",
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
