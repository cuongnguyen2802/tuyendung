{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && node_modules/.bin/prisma generate --schema=packages/database/prisma/schema.prisma && pnpm --filter @tuyendung/api build",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
