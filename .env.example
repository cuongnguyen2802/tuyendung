# PostgreSQL
POSTGRES_USER=tuyendung
POSTGRES_PASSWORD=tuyendung123
POSTGRES_DB=tuyendung
DATABASE_URL="postgresql://tuyendung:tuyendung123@localhost:5432/tuyendung"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Meilisearch
MEILI_MASTER_KEY=meili_master_key_dev
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meili_master_key_dev

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=tuyendung-files

# App
API_PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Email (Resend)
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=noreply@tuyendung.vn

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
AI_MOCK=true   # bật mock miễn phí khi dev, xóa dòng này khi có API key thật

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_change_in_production

# OAuth providers (để trống nếu chưa dùng)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Security — shared secret between NextAuth server and NestJS backend
# Prevents external callers from spoofing the internal OAuth endpoint.
# Generate with: openssl rand -hex 32
OAUTH_INTERNAL_SECRET=change_me_to_random_32byte_hex_in_production
